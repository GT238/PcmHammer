        <PidParameter id="IgnitionTiming" units="°" zoom="False" />
        <PidParameter id="TargetAFRatio" units="AFR" zoom="False" />
        <PidParameter id="KnockRetardDegrees" units="°" zoom="False" />
        <PidParameter id="ShortTermFTLeftBank" units="%" zoom="False" />
        <PidParameter id="LongTermFTLeftBank" units="%" zoom="False" />
        <PidParameter id="ShortTermFTRightBank" units="%" zoom="False" />
        <PidParameter id="LongTermFTRightBank" units="%" zoom="False" />
        <PidParameter id="ECTSensor" units="°F" zoom="False" />
        <PidParameter id="IATSensor" units="°F" zoom="False" />
        <PidParameter id="Ignition1Signal" units="Volts" zoom="False" />
